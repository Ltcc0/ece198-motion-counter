{
  "name": "ece198-motion-counter",
  "main": "cloud/worker.js",
  "account_id": "f093ecdd8efe598178dcd27a14e0e3c1",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    {"pattern": "sagacopilot.com", "custom_domain": true, "zone_name": "sagacopilot.com"},
    {"pattern": "www.sagacopilot.com", "custom_domain": true, "zone_name": "sagacopilot.com"}
  ],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ece198-motion-training",
    "database_id": "49d787c7-2324-4707-9490-75758b2d93e4",
    "migrations_dir": "cloud/migrations"
  }],
  "ratelimits": [{
    "name": "AUTH_LIMIT",
    "namespace_id": "198001",
    "simple": {"limit": 25, "period": 60}
  }, {
    "name": "ANALYSIS_LIMIT",
    "namespace_id": "198002",
    "simple": {"limit": 4, "period": 60}
  }]
}
